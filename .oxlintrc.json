{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "error"
	},
	"rules": {},
	"env": {
		"builtin": true
	},
	"ignorePatterns": [
		"articles/**",
		"books/**",
		"images/**",
		".claude/**",
		".codex/**",
		".cursor/**",
		".entire/**",
		".gemini/**",
		".opencode/**",
		".pi/**"
	]
}
